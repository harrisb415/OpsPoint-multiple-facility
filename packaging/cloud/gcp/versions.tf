# OpsPoint on Google Cloud (profile gcp). Infrastructure Manager runs Terraform 1.5, so nothing
# here may need a newer one.
terraform {
  required_version = ">= 1.5"
  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 6.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }
}

provider "google" {
  project = var.project_id
  region  = var.region
}
