# Dependencies
node_modules/

# Database & sensitive runtime data — NEVER commit these
data/opspoint.db
data/opspoint.db.*
data/opspoint.db-shm
data/opspoint.db-wal
data/shift.db
data/shift.db-shm
data/shift.db-wal
data/secret.key
# Database encryption key — NEVER commit. Losing it makes the database and
# every backup permanently unreadable, so back it up outside the repo.
data/.dbkey
# Pre-encryption safety copies are plaintext PHI — including WAL/SHM sidecars
data/*.pre-encryption-*
data/photos/
data/cert.pem
data/key.pem

# Updater runtime — staged downloads, code backups, DB backups
data/updates/
data/backups/

# Keep the data directory itself (server needs it)
!data/.gitkeep

# Release builder output (scripts/release.mjs)
release/

# Release SIGNING private key — NEVER commit. Back this up securely; if lost,
# generate a new keypair and re-pin the public key in updater.js + central/updater.js.
release-private.pem
central/data/
central/data_*/

# Claude Code local settings
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
